set fallback := true
repo_root := justfile_directory()
python_qc_justfile := "/home/dzack/ai/quality-control/justfile"

default:
    @just test

install:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{repo_root}}"
    exec uv sync --group dev

test:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{repo_root}}"
    exec just --justfile "{{python_qc_justfile}}" --working-directory "{{repo_root}}" test

test-ci:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{repo_root}}"
    exec just --justfile "{{python_qc_justfile}}" --working-directory "{{repo_root}}" test-ci
