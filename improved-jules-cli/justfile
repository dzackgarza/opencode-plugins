set fallback := true
repo_root := justfile_directory()

default:
    @just test

install:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{repo_root}}"
    exec uv sync

set-key:
    @echo "Run: jules-cli config-set-api-key YOUR_API_KEY"
    @echo "Or set JULES_API_KEY env var"

list:
    jules-cli list

watch ID:
    jules-cli watch {{ID}}

reprompt ID MESSAGE:
    jules-cli re-prompt {{ID}} "{{MESSAGE}}"

[private]
_lint:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{repo_root}}"
    exec uvx ruff check .

[private]
_format:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{repo_root}}"
    exec uvx ruff format .

[private]
_typecheck:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{repo_root}}"
    exec uvx basedpyright

test:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "No tests directory found in {{repo_root}}. Add tests before enabling the quality-control gate." >&2
    exit 1

check: test
